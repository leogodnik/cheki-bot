# Токен бота из @BotFather. Необязательно: без него бот работает только
# через браузер.
BOT_TOKEN=

# Адрес веб-приложения Apps Script, заканчивается на /exec
SHEET_URL=

# Секрет: ровно та же строка, что в первой строке sheet.gs
SHEET_SECRET=

# Адрес самой таблицы — для кнопки «Таблица» в рабочем месте. Необязательно.
SHEET_LINK=
